# Copy this file to .env.local and fill in the values (.env.local is never committed).
# Do not put real values in this file: it is published with the repository.

# --- Quote request e-mails (server only) ---
RESEND_API_KEY=
ORDER_TO_EMAIL=
# Optional: sender address verified on Resend (defaults to onboarding@resend.dev)
ORDER_FROM_EMAIL=

# --- Site settings (exposed to the browser) ---
# Public URL of the site (sitemap, Open Graph). Set it once the domain is chosen.
NEXT_PUBLIC_SITE_URL=
# Minimum lead time for an order, in days (default 3)
NEXT_PUBLIC_MIN_LEAD_DAYS=3
NEXT_PUBLIC_CITY=
# WhatsApp number in international format, without "+" or spaces (e.g. 33612345678)
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# --- Legal information (legal notice, terms, privacy policy) ---
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_STATUS=
NEXT_PUBLIC_LEGAL_SIRET=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_HOST_NAME=
NEXT_PUBLIC_HOST_ADDRESS=
NEXT_PUBLIC_MEDIATOR=
